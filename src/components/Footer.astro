---
import { site } from '../content/site';

const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/brand/logo-mono.svg" alt="Интеллект — образовательный центр" width="204" height="54" />
        <p>Образовательный центр в Ликино-Дулёво с 2009 года. 40 направлений для детей 2–17 лет.</p>
      </div>
      <nav class="footer__nav" aria-label="Навигация в подвале">
        <a href="/avatar">Игровая комната «Аватар»</a>
        <a href="/mango">Студия танцев «ManGO»</a>
        <a href={`${prefix}#directions`}>Направления</a>
        <a href={`${prefix}#prices`}>Цены</a>
        <a href={`${prefix}#contacts`}>Контакты</a>
      </nav>
      <div class="footer__contacts">
        <a href={site.phoneHref} class="footer__phone" data-goal="phone">{site.phoneDisplay}</a>
        <p>{site.branches[0].address}</p>
        <p>{site.branches[1].address}</p>
        <div class="footer__bots">
          <a class="footer__bot" href={site.bots.max} target="_blank" rel="noopener" data-goal="bot_max" aria-label="Бот в MAX" title="Бот в MAX: оплата и расписание">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            <span>MAX</span>
          </a>
          <a class="footer__bot" href={site.bots.telegram} target="_blank" rel="noopener" data-goal="bot_tg" aria-label="Бот в Telegram" title="Бот в Telegram: оплата и расписание">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M21.94 4.6l-3.2 15.07c-.24 1.06-.87 1.32-1.76.82l-4.87-3.59-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.95 9.03-8.16c.39-.35-.09-.55-.61-.2L6.61 13.2l-4.8-1.5c-1.04-.32-1.06-1.04.22-1.54l18.78-7.24c.87-.32 1.63.2 1.35 1.54z"/></svg>
            <span>Telegram</span>
          </a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <p>{site.legal.entity} · {site.legal.inn} · {site.legal.ogrnip}</p>
      <p class="footer__legal-links">
        <a href="/oplata">Оплата и возврат</a>
        <a href="/oferta">Публичная оферта</a>
        <a href="/politika">Политика конфиденциальности</a>
        <a href="/rekvizity">Реквизиты</a>
      </p>
      <p>© {new Date().getFullYear()} Интеллект. Все права защищены.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--indigo-dark);
    color: #dcd6ea;
    padding-block: clamp(40px, 5vw, 64px) 28px;
  }
  .footer a { color: #e8e3f5; }
  .footer__top {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .footer__brand img { height: 40px; width: auto; filter: brightness(0) invert(1); margin-bottom: 14px; }
  .footer__brand p { font-size: 14.5px; max-width: 34ch; }
  .footer__nav { display: flex; flex-direction: column; gap: 10px; }
  .footer__nav a { text-decoration: none; font-weight: 600; font-size: 15px; }
  .footer__nav a:hover { color: #5eead4; }
  .footer__phone { display: block; font-size: 20px; font-weight: 800; text-decoration: none; margin-bottom: 8px; }
  .footer__contacts p { font-size: 14.5px; margin-bottom: 4px; }
  .footer__bots { display: flex; gap: 10px; margin-top: 12px; }
  .footer__bot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    color: #dcd6ea;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .footer__bot:hover { background: rgb(255 255 255 / 0.16); color: #5eead4; }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    padding-top: 24px;
    font-size: 13.5px;
    color: #9b94b5;
  }
  .footer__legal-links { display: flex; flex-wrap: wrap; gap: 20px; }
  .footer__legal-links a {
    color: #9b94b5;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .footer__legal-links a:hover { color: #e8e3f5; }
  @media (max-width: 860px) { .footer__top { grid-template-columns: 1fr; gap: 26px; } }
</style>
