---
import { site } from '../content/site';
// Нижняя плашка с CTA на мобильных — видна только на маленьких экранах.
---
<div class="sticky-cta">
  <a class="sticky-cta__phone" href={site.phoneHref} data-goal="phone" aria-label="Позвонить">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
  </a>
  <button class="btn btn--primary sticky-cta__btn" type="button" data-open-lead data-goal="cta_signup">Записаться</button>
</div>

<style>
  .sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: none;
    gap: 10px;
    align-items: center;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }
  .sticky-cta__phone {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--tint);
    color: var(--indigo);
  }
  .sticky-cta__btn { flex-grow: 1; }
  @media (max-width: 720px) {
    .sticky-cta { display: flex; }
    body { padding-bottom: 70px; }
  }
</style>
