---
import { site } from '../content/site';
---
<section class="section" id="contacts">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Контакты</span>
      <h2>Ждём вас и ваших детей</h2>
    </div>

    <div class="contacts__info">
      <div class="contacts__row">
        <h3>Телефон</h3>
        <p><a href={site.phoneHref} data-goal="phone">{site.phoneDisplay}</a></p>
      </div>
      <div class="contacts__row">
        <h3>Мессенджеры и почта</h3>
        <p class="contacts__messengers">
          <a href={site.max} target="_blank" rel="noopener" data-goal="max">MAX</a>
          <a href={site.vk} target="_blank" rel="noopener" data-goal="vk">ВКонтакте</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
      <div class="contacts__row">
        <h3>Часы работы</h3>
        <p>{site.hours}</p>
      </div>
    </div>

    <div class="contacts__bots">
      <p class="contacts__bots-label">Боты: персональная ссылка на оплату и расписание</p>
      <div class="contacts__bots-grid">
        <a class="contacts__bot" href={site.bots.max} target="_blank" rel="noopener" data-goal="bot_max">
          <span class="contacts__bot-icon contacts__bot-icon--max" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </span>
          <span>Бот в MAX</span>
        </a>
        <a class="contacts__bot" href={site.bots.telegram} target="_blank" rel="noopener" data-goal="bot_tg">
          <span class="contacts__bot-icon contacts__bot-icon--tg" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M21.94 4.6l-3.2 15.07c-.24 1.06-.87 1.32-1.76.82l-4.87-3.59-2.35 2.26c-.26.26-.48.48-.98.48l.35-4.95 9.03-8.16c.39-.35-.09-.55-.61-.2L6.61 13.2l-4.8-1.5c-1.04-.32-1.06-1.04.22-1.54l18.78-7.24c.87-.32 1.63.2 1.35 1.54z"/></svg>
          </span>
          <span>Бот в Telegram</span>
        </a>
      </div>
    </div>

    <div class="contacts__branches">
      {site.branches.map((b) => (
        <div class="contacts__branch card">
          <div class="contacts__branch-info">
            <span class="contacts__branch-tag">{b.name}</span>
            <h3>{b.address}</h3>
            <a class="btn btn--outline" href={b.mapHref} target="_blank" rel="noopener">Построить маршрут →</a>
          </div>
          <div class="contacts__map">
            <iframe
              src={`https://yandex.ru/map-widget/v1/?z=16&ol=biz&oid=${b.yandexOid}`}
              title={`${b.name}: ${b.address}`}
              loading="lazy"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .contacts__info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .contacts__row h3 { font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--teal); margin-bottom: 6px; }
  .contacts__row p { font-size: 17px; font-weight: 600; }
  .contacts__row a { color: var(--text); text-decoration: none; }
  .contacts__row a:hover { color: var(--indigo); }
  .contacts__messengers { display: flex; flex-wrap: wrap; gap: 18px; }
  .contacts__messengers a { color: var(--indigo); font-weight: 700; }

  .contacts__bots { margin-bottom: clamp(28px, 4vw, 44px); }
  .contacts__bots-label { font-size: 14px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--teal); font-weight: 700; margin-bottom: 12px; }
  .contacts__bots-grid { display: flex; flex-wrap: wrap; gap: 14px; }
  .contacts__bot {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text);
    font-weight: 700;
    font-size: 15px;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .contacts__bot:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--teal-bright); }
  .contacts__bot-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: #fff; flex-shrink: 0; }
  .contacts__bot-icon--max { background: var(--grad-teal); }
  .contacts__bot-icon--tg { background: linear-gradient(135deg, #229ED9, #1c8bc4); }

  .contacts__branches {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .contacts__branch {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .contacts__branch-info { padding: 24px 24px 8px; }
  .contacts__branch-tag {
    display: inline-block;
    margin-bottom: 10px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--teal);
    font-weight: 700;
    font-size: 13px;
  }
  .contacts__branch-info h3 { font-size: 18px; margin-bottom: 16px; }
  .contacts__map { min-height: 260px; }
  .contacts__map iframe { width: 100%; height: 260px; border: 0; }
  @media (max-width: 860px) {
    .contacts__info { grid-template-columns: 1fr; gap: 18px; }
    .contacts__branches { grid-template-columns: 1fr; }
  }
</style>
