---
import Photo from './Photo.astro';
// Секция-мост к суб-брендам центра: игровая комната «Аватар» и студия танцев «ManGO».
---
<section class="section subbrands">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="kicker">Не только учёба</span>
      <h2>Праздники и танцы в нашем центре</h2>
      <p class="lead">Помимо образовательных программ, у нас есть игровая комната для детских праздников и студия танцев и фитнеса.</p>
    </div>

    <div class="subbrands__grid">
      <a class="subbrands__card subbrands__card--avatar" href="/avatar">
        <div class="subbrands__media">
          <Photo name="atmosphere-girls-playroom" ratio="16 / 10" position="center 40%" />
        </div>
        <div class="subbrands__body">
          <span class="subbrands__tag">🎈 Игровая комната</span>
          <h3>Аватар</h3>
          <p>Детские праздники под ключ: батутный лабиринт, квесты, аниматоры, гамаки и «Мафия». Аренда от 1200 ₽/час.</p>
          <span class="subbrands__link">Открыть страницу →</span>
        </div>
      </a>

      <a class="subbrands__card subbrands__card--mango" href="/mango">
        <div class="subbrands__media">
          <Photo name="dance-class" ratio="16 / 10" position="center 30%" />
        </div>
        <div class="subbrands__body">
          <span class="subbrands__tag">💃 Студия танцев</span>
          <h3>ManGO</h3>
          <p>Художественная гимнастика, флай-йога, джампинг, k-pop cover dance и хатха-йога для детей.</p>
          <span class="subbrands__link">Открыть страницу →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .subbrands__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .subbrands__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .subbrands__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .subbrands__media { overflow: hidden; }
  .subbrands__media :global(.photo) { transition: transform 0.4s ease; }
  .subbrands__card:hover .subbrands__media :global(.photo) { transform: scale(1.05); }
  .subbrands__body { padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .subbrands__tag {
    align-self: flex-start;
    padding: 6px 14px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 13px;
    background: var(--tint);
    color: var(--teal);
  }
  .subbrands__card--mango .subbrands__tag { background: var(--tint); color: var(--teal); }
  .subbrands__card h3 { font-size: clamp(24px, 3vw, 32px); }
  .subbrands__card p { color: var(--muted); font-size: 15.5px; flex-grow: 1; }
  .subbrands__link { font-weight: 700; color: var(--indigo); margin-top: 6px; }
  @media (max-width: 760px) {
    .subbrands__grid { grid-template-columns: 1fr; }
  }
</style>
