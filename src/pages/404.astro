---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL;
const b = (p: string) => `${base.replace(/\/$/, '')}${p}`;
---
<BaseLayout title="Страница не найдена — Интеллект" description="Запрашиваемая страница не найдена." path="/404">
  <Header />
  <main id="main" class="section">
    <div class="container" style="text-align:center; max-width:560px">
      <div style="font-size:72px; margin-bottom:16px">🧭</div>
      <h1>Страница куда-то убежала</h1>
      <p class="lead">Похоже, такой страницы нет или она переехала. Давайте вернёмся к учёбе.</p>
      <p style="margin-top:24px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap">
        <a class="btn btn--primary btn--lg" href={b("/")}>На главную</a>
        <a class="btn btn--outline btn--lg" href="/#directions">Выбрать направление</a>
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>
