---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../content/site';
// Страница успешной оплаты — не индексируется (robots.txt + noindex).
---
<BaseLayout title="Оплата прошла успешно — Интеллект" description="Ваш платёж принят. Спасибо за оплату занятий в образовательном центре «Интеллект»." path="/oplata/uspekh">
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <Header />
  <main id="main" class="section">
    <div class="container">
      <article class="legal" style="text-align:center">
        <div style="font-size:64px; margin-bottom:16px">✅</div>
        <h1>Оплата прошла успешно!</h1>
        <p>Спасибо! Ваш платёж принят. Администратор свяжется с вами для подтверждения расписания занятий.</p>
        <p style="margin-top:24px"><a class="btn btn--primary" href="/">Вернуться на главную</a></p>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>
