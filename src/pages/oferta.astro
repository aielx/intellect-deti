---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../content/site';

const { entity, inn, ogrnip, legalAddress, checkingAccount, bankName, bik, corrAccount } = site.legal;
const base = import.meta.env.BASE_URL;
const b = (p: string) => `${base.replace(/\/$/, '')}${p}`;
---
<BaseLayout title="Публичная оферта — Интеллект" description="Публичная оферта образовательного центра «Интеллект»: предмет, стоимость, порядок оплаты и возврата." path="/oferta">
  <Header />
  <main id="main" class="section">
    <div class="container">
      <article class="legal">
        <h1>Публичная оферта</h1>
        <p>Настоящий документ является официальным предложением (публичной офертой) {entity} ({inn}, {ogrnip}), именуемого в дальнейшем «Исполнитель», к заключению договора на оказание образовательных услуг на изложенных ниже условиях.</p>

        <h2>1. Предмет договора</h2>
        <p>Исполнитель обязуется оказать Заказчику (родителю или законному представителю несовершеннолетнего) образовательные услуги: занятия по выбранным направлениям (подготовка к школе, школьные предметы, подготовка к экзаменам, ИТ-школа, иностранные языки, логопед, психолог, творческие и академические мастерские, танцы и др.), а Заказчик обязуется принять и оплатить эти услуги.</p>

        <h2>2. Стоимость услуг и порядок оплаты</h2>
        <p>Стоимость занятий зависит от направления, формата (групповые или индивидуальные) и длительности. Актуальные цены и расписание согласовываются с администратором. Оплата производится онлайн через {site.paymentProvider} (карты МИР, Visa, MasterCard, JCB) в личном кабинете либо по согласованной ссылке. Оказание услуг начинается после поступления оплаты.</p>

        <h2>3. Порядок возврата</h2>
        <p>Возврат средств производится в течение 30 календарных дней с момента получения соответствующего письменного заявления Заказчика. Возврат осуществляется на банковскую карту, с которой был произведён платёж. Подробные условия — на странице <a href={b("/oplata")}>«Оплата и возврат»</a>.</p>

        <h2>4. Права и обязанности сторон</h2>
        <ul>
          <li>Исполнитель обязуется оказывать услуги качественно и в согласованные сроки, обеспечивая безопасность и комфорт образовательной среды.</li>
          <li>Заказчик обязуется своевременно оплачивать услуги и соблюдать правила внутреннего распорядка центра.</li>
          <li>Стороны обязуются незамедлительно информировать друг друга об обстоятельствах, препятствующих оказанию/получению услуг.</li>
        </ul>

        <h2>5. Ответственность сторон</h2>
        <p>Стороны несут ответственность за неисполнение или ненадлежащее исполнение обязательств в соответствии с действующим законодательством Российской Федерации.</p>

        <h2>6. Разрешение споров</h2>
        <p>Все споры и разногласия стороны стремятся решить путём переговоров. При недостижении согласия спор передаётся на рассмотрение в суд в установленном законом порядке.</p>

        <h2>7. Реквизиты Исполнителя</h2>
        <ul>
          <li><strong>{entity}</strong></li>
          <li>{inn}, {ogrnip}</li>
          <li>Юридический адрес: {legalAddress}</li>
          {checkingAccount && <li>Р/с {checkingAccount}</li>}
          {bankName && <li>{bankName}</li>}
          {bik && <li>БИК {bik}</li>}
          {corrAccount && <li>К/с {corrAccount}</li>}
          <li>E-mail: {site.email}</li>
          <li>Телефон: {site.phoneDisplay}</li>
        </ul>
        <p>Совершая оплату или оставляя заявку, Заказчик подтверждает согласие с условиями настоящей оферты и <a href={b("/politika")}>политикой обработки персональных данных</a>.</p>
      </article>
    </div>
  </main>
  <Footer />
  <StickyCta />
  <BackToTop />
  <script define:vars={{ leadWebhook: site.leadWebhook, metricaId: site.metricaId }}>
    window.__leadWebhook = leadWebhook;
    window.__metricaId = metricaId;
  </script>
</BaseLayout>
