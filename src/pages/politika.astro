---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../content/site';
const base = import.meta.env.BASE_URL;
const b = (p: string) => `${base.replace(/\/$/, '')}${p}`;
---
<BaseLayout title="Политика конфиденциальности — Интеллект" description="Политика обработки персональных данных образовательного центра «Интеллект»." path="/politika">
  <Header />
  <main id="main" class="section">
    <div class="container">
      <article class="legal">
        <h1>Политика конфиденциальности</h1>
        <p>Настоящая Политика определяет порядок обработки и защиты {site.legal.entity} (далее — «Оператор») персональных данных пользователей сайта {site.parentSite}.</p>

        <h2>1. Какие данные мы собираем</h2>
        <ul>
          <li>Контактные данные, указанные в формах заявки: имя, телефон, возраст ребёнка, выбранное направление;</li>
          <li>Технические данные: cookie-файлы, IP-адрес, тип устройства и браузера (для работы счётчиков посещаемости).</li>
        </ul>

        <h2>2. Цели обработки</h2>
        <ul>
          <li>Обработка заявок на запись и связь с клиентами;</li>
          <li>Оказание и оплата образовательных услуг;</li>
          <li>Улучшение работы сайта и качества услуг;</li>
          <li>Соблюдение требований законодательства РФ.</li>
        </ul>

        <h2>3. Правовое основание</h2>
        <p>Обработка персональных данных осуществляется на основе согласия пользователя, выраженного путём заполнения форм и использования сайта, в соответствии с Федеральным законом № 152-ФЗ «О персональных данных».</p>

        <h2>4. Передача данных третьим лицам</h2>
        <p>Персональные данные не передаются третьим лицам, за исключением случаев, предусмотренных законодательством, а также сервисов, обеспечивающих работу сайта и оплаты (Яндекс.Метрика, {site.paymentProvider}). Для записи заявок может использоваться Google Таблица.</p>

        <h2>5. Срок хранения</h2>
        <p>Персональные данные хранятся в течение срока, необходимого для достижения целей обработки, либо до отзыва согласия пользователем.</p>

        <h2>6. Права пользователя</h2>
        <ul>
          <li>Получать информацию об обработке своих данных;</li>
          <li>Требовать уточнения, блокирования или уничтожения своих данных;</li>
          <li>Отозвать согласие на обработку, направив обращение на {site.email}.</li>
        </ul>

        <h2>7. Контакты Оператора</h2>
        <ul>
          <li>{site.legal.entity}</li>
          <li>{site.legal.inn}, {site.legal.ogrnip}</li>
          <li>{site.legal.legalAddress}</li>
          <li>{site.email} · {site.phoneDisplay}</li>
        </ul>
      </article>
    </div>
  </main>
  <Footer />
  <StickyCta />
  <BackToTop />
  <script define:vars={{ leadWebhook: site.leadWebhook, metricaId: site.metricaId }}>
    window.__leadWebhook = leadWebhook;
    window.__metricaId = metricaId;
  </script>
</BaseLayout>
