---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import StickyCta from '../components/StickyCta.astro';
import BackToTop from '../components/BackToTop.astro';
import Photo from '../components/Photo.astro';
import { site } from '../content/site';

const title = 'Студия танцев и фитнеса ManGO — Ликино-Дулёво | Центр «Интеллект»';
const description = 'Студия ManGO для детей: художественная гимнастика, флай-йога, джампинг, k-pop cover dance и хатха-йога. Запись и расписание в центре «Интеллект».';

const styles = [
  { icon: '🤸', title: 'Художественная гимнастика', desc: 'Гибкость, грация и координация для девочек.' },
  { icon: '🧘‍♀️', title: 'Флай-йога', desc: 'Йога в гамаках — растяжка и укрепление мышц без нагрузки на позвоночник.' },
  { icon: '🤾', title: 'Джампинг', desc: 'Кардио на батутах — фитнес с эффектом полёта и отличный настрой.' },
  { icon: '🎵', title: 'K-pop cover dance', desc: 'Танцевальные каверы на популярные корейские хиты для детей и подростков.' },
  { icon: '☯️', title: 'Хатха-йога', desc: 'Разумный баланс тела и ума, доступный любому уровню подготовки ребёнка.' },
];
---
<BaseLayout title={title} description={description} path="/mango">
  <Header />
  <main id="main">
    <!-- HERO -->
    <section class="m-hero">
      <div class="container m-hero__inner">
        <div class="m-hero__text">
          <span class="badge">💃 Студия танцев и фитнеса для детей</span>
          <h1>ManGO — <span class="m-hero__hl">двигайся в ритме</span></h1>
          <p class="lead">Танцы и фитнес для детей: художественная гимнастика, флай-йога, джампинг, k-pop cover dance и хатха-йога. Студия в составе центра «Интеллект».</p>
          <div class="m-hero__cta">
            <button class="btn btn--primary btn--lg" type="button" data-open-lead data-direction="dance-sport" data-goal="mango_signup">Записаться</button>
            <a class="btn btn--outline btn--lg" href={site.phoneHref} data-goal="phone">📞 Позвонить</a>
          </div>
        </div>
        <div class="m-hero__media">
          <Photo name="dance-class" ratio="4 / 5" ratioMobile="16 / 11" sizes="(max-width: 980px) 100vw, 44vw" position="center 30%" class="m-hero__frame" />
        </div>
      </div>
    </section>

    <!-- STYLES -->
    <section class="section" id="styles">
      <div class="container">
        <div class="section-head section-head--center">
          <span class="kicker">Направления</span>
          <h2>Чем займёмся</h2>
          <p class="lead">Пять направлений танцев и фитнеса для детей — выбирайте по интересам и возрасту.</p>
        </div>
        <div class="m-styles__grid">
          {styles.map((s, i) => (
            <div class:list={['m-styles__card', 'card', 'reveal']} style={`transition-delay: ${(i % 4) * 60}ms`}>
              <div class="m-styles__icon">{s.icon}</div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section m-cta">
      <div class="container m-cta__inner">
        <div>
          <h2>Готовы начать?</h2>
          <p class="lead">Оставьте заявку — подберём направление и удобное время первого занятия для вашего ребёнка.</p>
        </div>
        <button class="btn btn--warm btn--lg" type="button" data-open-lead data-direction="dance-sport" data-goal="mango_cta">Записаться в ManGO</button>
      </div>
    </section>
  </main>

  <Footer />
  <LeadForm />
  <StickyCta />
  <BackToTop />

  <script define:vars={{ leadWebhook: site.leadWebhook, metricaId: site.metricaId }}>
    window.__leadWebhook = leadWebhook;
    window.__metricaId = metricaId;
  </script>
</BaseLayout>

<style>
  .m-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 85% 10%, rgb(20 184 166 / 0.16), transparent 60%),
      radial-gradient(50% 60% at 5% 90%, rgb(49 46 129 / 0.10), transparent 60%),
      var(--bg);
    padding-block: clamp(40px, 6vw, 84px);
  }
  .m-hero__inner { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .m-hero__hl { background: var(--grad-teal); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .m-hero .lead { max-width: 52ch; }
  .m-hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }
  .m-hero__media :global(.m-hero__frame) { border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  @media (max-width: 980px) { .m-hero__inner { grid-template-columns: 1fr; } .m-hero__media { order: -1; } }

  .m-styles__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .m-styles__card { padding: 26px 22px; }
  .m-styles__icon { width: 56px; height: 56px; display: grid; place-items: center; font-size: 28px; border-radius: 16px; background: var(--tint); margin-bottom: 16px; }
  .m-styles__card h3 { font-size: 17px; margin-bottom: 8px; }
  .m-styles__card p { font-size: 14.5px; color: var(--muted); }

  .m-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; max-width: 860px; }
  .m-cta__inner .lead { margin-top: 8px; }
</style>
